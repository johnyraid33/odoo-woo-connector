<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19 and 20 replaced the group category with a "privilege" scope. -->
    <record id="privilege_woocommerce" model="res.groups.privilege">
        <field name="name">WooCommerce</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_woocommerce_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_woocommerce"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_woocommerce_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_woocommerce"/>
        <field name="implied_ids" eval="[(4, ref('group_woocommerce_user'))]"/>
    </record>
</odoo>
