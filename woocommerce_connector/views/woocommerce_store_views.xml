<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="woo_store_view_list" model="ir.ui.view">
        <field name="name">woo.store.list</field>
        <field name="model">woo.store</field>
        <field name="arch" type="xml">
            <list string="WooCommerce stores" decoration-danger="connection_state == 'error'">
                <field name="name"/>
                <field name="base_url"/>
                <field name="connection_state" widget="badge"
                       decoration-success="connection_state == 'ok'"
                       decoration-warning="connection_state == 'draft'"/>
                <field name="api_version"/>
                <field name="currency_id"/>
                <field name="last_order_sync"/>
                <field name="job_pending_count"/>
                <field name="job_failed_count" decoration-danger="job_failed_count &gt; 0"/>
            </list>
        </field>
    </record>

    <record id="woo_store_view_form" model="ir.ui.view">
        <field name="name">woo.store.form</field>
        <field name="model">woo.store</field>
        <field name="arch" type="xml">
            <form string="WooCommerce store">
                <header>
                    <button name="action_test_connection" type="object"
                            string="Test connection" class="btn-primary"/>
                    <button name="action_register_webhooks" type="object"
                            string="Register webhooks"/>
                    <button name="action_sync_now" type="object" string="Sync now"/>
                    <field name="connection_state" widget="statusbar"
                           statusbar_visible="draft,ok,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="For example: Main shop"/></h1>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="base_url" placeholder="https://shop.example.com"/>
                            <field name="consumer_key" password="True"/>
                            <field name="consumer_secret" password="True"/>
                            <field name="api_version" readonly="1"/>
                            <field name="last_test_date" readonly="1"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="prices_include_tax" readonly="1"/>
                        </group>
                        <group string="Accounting">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="warehouse_id"/>
                            <field name="pricelist_id"/>
                            <field name="default_product_category_id"/>
                            <field name="shipping_product_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Synchronisation">
                            <field name="sync_products"/>
                            <field name="export_products"/>
                            <field name="sync_orders"/>
                            <field name="sync_customers"/>
                            <field name="sync_refunds"/>
                            <field name="push_tracking"/>
                            <field name="auto_confirm_orders"/>
                            <field name="auto_create_products"/>
                        </group>
                        <group string="Stock">
                            <field name="stock_master"/>
                            <field name="stock_quantity_type"/>
                        </group>
                    </group>
                    <group>
                        <group string="Webhooks">
                            <field name="webhook_url" readonly="1" widget="CopyClipboardChar"/>
                            <field name="webhook_secret" password="True" readonly="1"/>
                            <field name="webhook_registration" readonly="1"/>
                        </group>
                        <group string="Advanced">
                            <field name="total_tolerance"/>
                            <field name="job_max_attempts"/>
                            <field name="last_product_sync" readonly="1"/>
                            <field name="last_order_sync" readonly="1"/>
                        </group>
                    </group>
                    <div class="text-danger" colspan="2" invisible="not last_error">
                        <field name="last_error" readonly="1" nolabel="1"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="woo_store_view_search" model="ir.ui.view">
        <field name="name">woo.store.search</field>
        <field name="model">woo.store</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="base_url"/>
                <filter name="connected" string="Connected"
                        domain="[('connection_state', '=', 'ok')]"/>
                <filter name="errors" string="With errors"
                        domain="[('connection_state', '=', 'error')]"/>
            </search>
        </field>
    </record>

    <record id="woo_store_action" model="ir.actions.act_window">
        <field name="name">Stores</field>
        <field name="res_model">woo.store</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Connect your first WooCommerce store</p>
            <p>Create a consumer key and secret in WooCommerce &gt; Settings &gt; Advanced &gt;
               REST API, then paste them here.</p>
        </field>
    </record>
</odoo>
