<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_process_queue" model="ir.cron">
        <field name="name">WooCommerce: process the synchronisation queue</field>
        <field name="model_id" ref="model_woo_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_queue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <record id="ir_cron_poll_orders" model="ir.cron">
        <field name="name">WooCommerce: poll orders</field>
        <field name="model_id" ref="model_woo_store"/>
        <field name="state">code</field>
        <field name="code">model._cron_poll_orders()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <record id="ir_cron_poll_products" model="ir.cron">
        <field name="name">WooCommerce: poll products</field>
        <field name="model_id" ref="model_woo_store"/>
        <field name="state">code</field>
        <field name="code">model._cron_poll_products()</field>
        <field name="interval_number">60</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <record id="ir_cron_push_stock" model="ir.cron">
        <field name="name">WooCommerce: push stock</field>
        <field name="model_id" ref="model_woo_store"/>
        <field name="state">code</field>
        <field name="code">model._cron_push_stock()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <record id="ir_cron_push_products" model="ir.cron">
        <field name="name">WooCommerce: export products</field>
        <field name="model_id" ref="model_woo_store"/>
        <field name="state">code</field>
        <field name="code">model._cron_push_products()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <record id="ir_cron_pull_stock" model="ir.cron">
        <field name="name">WooCommerce: pull stock</field>
        <field name="model_id" ref="model_woo_store"/>
        <field name="state">code</field>
        <field name="code">model._cron_pull_stock()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <record id="ir_cron_pull_customers" model="ir.cron">
        <field name="name">WooCommerce: import customers</field>
        <field name="model_id" ref="model_woo_store"/>
        <field name="state">code</field>
        <field name="code">model._cron_pull_customers()</field>
        <field name="interval_number">120</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
