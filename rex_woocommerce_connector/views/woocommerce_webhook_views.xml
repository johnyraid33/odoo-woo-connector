<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="woo_webhook_view_list" model="ir.ui.view">
        <field name="name">woo.webhook.list</field>
        <field name="model">woo.webhook</field>
        <field name="arch" type="xml">
            <list string="Webhook deliveries" create="0" edit="0">
                <field name="received_at"/>
                <field name="store_id"/>
                <field name="topic"/>
                <field name="resource_id"/>
                <field name="state" widget="badge"/>
                <field name="woo_id"/>
            </list>
        </field>
    </record>

    <record id="woo_webhook_view_form" model="ir.ui.view">
        <field name="name">woo.webhook.form</field>
        <field name="model">woo.webhook</field>
        <field name="arch" type="xml">
            <form string="Webhook delivery" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="received_at"/>
                            <field name="store_id"/>
                            <field name="topic"/>
                            <field name="resource_id"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="woo_id"/>
                            <field name="processed_at"/>
                        </group>
                    </group>
                    <field name="payload" widget="ace" options="{'mode': 'json'}"/>
                    <field name="error" invisible="not error"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="woo_webhook_view_search" model="ir.ui.view">
        <field name="name">woo.webhook.search</field>
        <field name="model">woo.webhook</field>
        <field name="arch" type="xml">
            <search>
                <field name="topic"/>
                <field name="store_id"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
            </search>
        </field>
    </record>

    <record id="woo_webhook_action" model="ir.actions.act_window">
        <field name="name">Webhook deliveries</field>
        <field name="res_model">woo.webhook</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
