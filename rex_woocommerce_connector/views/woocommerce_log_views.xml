<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="woo_log_view_list" model="ir.ui.view">
        <field name="name">woo.log.list</field>
        <field name="model">woo.log</field>
        <field name="arch" type="xml">
            <list string="Activity log" decoration-danger="level == 'error'"
                  decoration-warning="level == 'warning'" create="0" edit="0">
                <field name="date"/>
                <field name="store_id"/>
                <field name="level" widget="badge"/>
                <field name="message"/>
                <field name="http_status"/>
                <field name="woo_code"/>
                <field name="job_id"/>
            </list>
        </field>
    </record>

    <record id="woo_log_view_form" model="ir.ui.view">
        <field name="name">woo.log.form</field>
        <field name="model">woo.log</field>
        <field name="arch" type="xml">
            <form string="Log line" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="store_id"/>
                            <field name="level"/>
                            <field name="job_id"/>
                        </group>
                        <group>
                            <field name="http_status"/>
                            <field name="woo_code"/>
                            <field name="url"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                        </group>
                    </group>
                    <field name="message"/>
                    <field name="payload" widget="ace" options="{'mode': 'json'}"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="woo_log_view_search" model="ir.ui.view">
        <field name="name">woo.log.search</field>
        <field name="model">woo.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="message"/>
                <field name="store_id"/>
                <filter name="errors" string="Errors" domain="[('level', '=', 'error')]"/>
                <filter name="warnings" string="Warnings" domain="[('level', '=', 'warning')]"/>
                <group>
                    <filter name="group_level" string="Level" context="{'group_by': 'level'}"/>
                    <filter name="group_store" string="Store" context="{'group_by': 'store_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="woo_log_action" model="ir.actions.act_window">
        <field name="name">Activity log</field>
        <field name="res_model">woo.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
