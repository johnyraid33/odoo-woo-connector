# Copy to dev/.env to override any of these. `dev.sh` and docker compose
# both read dev/.env automatically.
#
# Host ports. 8090/8091 are the project defaults; change them if they are
# taken on your machine (the compose file only publishes these ports).
ODOO_PORT=8090
WP_PORT=8091
# Self-signed HTTPS endpoint (loopback only). WooCommerce requires SSL for
# HTTP Basic auth, so the REST API is verified through this port.
WP_HTTPS_PORT=8443

# Loopback-only ports for direct DB access (debugging / psql / mysql client).
# Not needed by the stack itself.
MYSQL_PORT=3307
ODOO_DB_PORT=5433

# Local, disposable credentials. Never reuse outside of this dev stack.
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
