# Copy to dev/multi/.env to override any of these.
# ./multi.sh and docker compose both read dev/multi/.env automatically.

# Host ports (defaults; change them if they are taken on your machine).
WP_PORT=8093
WP_HTTPS_PORT=8444
MYSQL_PORT=3308
PG_PORT=5434

# Self-signed HTTPS endpoint (loopback only). WooCommerce requires SSL for
# HTTP Basic auth, so the REST API is verified through this port.
# (Same value as WP_HTTPS_PORT.)

# Loopback-only ports for direct DB access (debugging).
# Not needed by the stack itself.

# Local, disposable credentials.
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress

# MAIN stack network joined by the WordPress container (external network).
MAIN_STACK_NETWORK=odoo-woo-connector-dev_default

# base_url for the connector (runs in the MAIN stack's Odoo container).
WOO_API_BASE_URL=https://wordpress-multi
