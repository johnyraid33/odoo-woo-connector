# Generated at runtime by ./multi.sh seed / ./multi.sh creds.
# Contains a real WooCommerce consumer key + secret: never commit it.
.woo_credentials.json

# Local machine overrides (ports, local passwords).
.env

# Self-signed dev TLS certificate (generated by scripts/gen-cert.sh).
certs/

# Docker named volumes are used instead of host directories, but ignore any
# accidental local state/log directory anyway.
logs/
.runtime/
*.log
